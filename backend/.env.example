# Copy to .env and fill in real values. NEVER commit .env.

# ---- Application ----
APP_NAME=MathMentor AI
APP_ENV=development            # development | test | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (Flutter dev / emulator)
CORS_ORIGINS=http://localhost,http://10.0.2.2

# ---- Database (local PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mathmentor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mathmentor
POSTGRES_TEST_DB=mathmentor_test
# URL-encode special characters in the password (e.g. '@' -> %40)
DATABASE_URL=postgresql+psycopg://mathmentor:change-me@localhost:5432/mathmentor
TEST_DATABASE_URL=postgresql+psycopg://mathmentor:change-me@localhost:5432/mathmentor_test

# ---- Gemini API (Google AI Studio, free tier) ----
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash
# Tried only when the primary model returns HTTP 404 (retired / not available to this key)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=2
# Free-tier guardrail: max Gemini calls per minute across the app
GEMINI_RATE_LIMIT_PER_MINUTE=10
GEMINI_RATE_LIMIT_PER_DAY=250
# Hard cap for POST /tutor/ask: Gemini gets TUTOR - SYMPY seconds, SymPy the rest
TUTOR_TIMEOUT_SECONDS=30

# ---- Math verification ----
SYMPY_TIMEOUT_SECONDS=5

# ---- Security ----
SECRET_KEY=generate-with-python-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
