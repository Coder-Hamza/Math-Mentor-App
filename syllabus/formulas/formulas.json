[
  {"unit_number": 1, "topic": "Introduction to Complex Numbers", "name": "Square of the imaginary unit", "expression": "I**2 = -1", "identity": true, "description": "i^2 = -1"},
  {"unit_number": 1, "topic": "Algebraic Operations on Complex Numbers", "name": "Product of complex numbers", "expression": "(a + I*b)*(c + I*d) = (a*c - b*d) + I*(a*d + b*c)", "identity": true, "description": "(a + bi)(c + di) = (ac − bd) + (ad + bc)i"},
  {"unit_number": 1, "topic": "Algebraic Operations on Complex Numbers", "name": "Quotient of complex numbers", "expression": "(a + I*b)/(c + I*d) = ((a*c + b*d) + I*(b*c - a*d))/(c**2 + d**2)", "identity": true, "description": "Multiply numerator and denominator by the conjugate of the denominator (c + di ≠ 0)."},
  {"unit_number": 1, "topic": "Conjugate and Modulus", "name": "Product of a complex number and its conjugate", "expression": "(x + I*y)*(x - I*y) = x**2 + y**2", "identity": true, "description": "z · z̄ = |z|^2"},
  {"unit_number": 1, "topic": "Conjugate and Modulus", "name": "Modulus of a complex number", "expression": "Abs(x + I*y) = sqrt(x**2 + y**2)", "identity": true, "description": "|x + iy| = √(x^2 + y^2) for real x, y"},
  {"unit_number": 1, "topic": "Argand Diagram and Polar Form", "name": "Polar form", "expression": "x + I*y = r*(cos(theta) + I*sin(theta))", "identity": false, "description": "r = |z| and θ = arg z, where x = r cos θ and y = r sin θ"},

  {"unit_number": 2, "topic": "Determinants and Their Properties", "name": "Determinant of a 2x2 matrix", "expression": "Matrix([[a, b], [c, d]]).det() = a*d - b*c", "identity": true, "description": "|A| = ad − bc"},
  {"unit_number": 2, "topic": "Determinants and Their Properties", "name": "Determinant of a 3x3 matrix (expansion along first row)", "expression": "Matrix([[a1, a2, a3], [b1, b2, b3], [c1, c2, c3]]).det() = a1*(b2*c3 - b3*c2) - a2*(b1*c3 - b3*c1) + a3*(b1*c2 - b2*c1)", "identity": true, "description": "Cofactor expansion along R1"},
  {"unit_number": 2, "topic": "Adjoint and Inverse of a Matrix", "name": "Inverse of a 2x2 matrix", "expression": "Matrix([[a, b], [c, d]]).inv() = Matrix([[d, -b], [-c, a]])/(a*d - b*c)", "identity": true, "description": "A^(-1) = adj(A)/|A| with |A| ≠ 0"},
  {"unit_number": 2, "topic": "Systems of Linear Equations", "name": "Cramer's rule", "expression": "x = Matrix([[k1, b1], [k2, b2]]).det()/Matrix([[a1, b1], [a2, b2]]).det()", "identity": false, "description": "For a1·x + b1·y = k1 and a2·x + b2·y = k2: x = Dx/D, y = Dy/D, with D ≠ 0"},

  {"unit_number": 3, "topic": "Vectors in Plane and Space", "name": "Magnitude of a vector", "expression": "magnitude = sqrt(x**2 + y**2 + z**2)", "identity": false, "description": "|r| for r = xi + yj + zk"},
  {"unit_number": 3, "topic": "Unit Vectors and Direction Cosines", "name": "Sum of squares of direction cosines", "expression": "(x/sqrt(x**2 + y**2 + z**2))**2 + (y/sqrt(x**2 + y**2 + z**2))**2 + (z/sqrt(x**2 + y**2 + z**2))**2 = 1", "identity": true, "description": "cos^2 α + cos^2 β + cos^2 γ = 1"},
  {"unit_number": 3, "topic": "Scalar (Dot) Product", "name": "Dot product in components", "expression": "Matrix([a1, a2, a3]).dot(Matrix([b1, b2, b3])) = a1*b1 + a2*b2 + a3*b3", "identity": true, "description": "a · b = a1b1 + a2b2 + a3b3"},
  {"unit_number": 3, "topic": "Scalar (Dot) Product", "name": "Angle between two vectors", "expression": "cos(theta) = (a1*b1 + a2*b2 + a3*b3)/(sqrt(a1**2 + a2**2 + a3**2)*sqrt(b1**2 + b2**2 + b3**2))", "identity": false, "description": "cos θ = (a · b)/(|a||b|)"},
  {"unit_number": 3, "topic": "Vector (Cross) Product", "name": "Cross product in components", "expression": "Matrix([a1, a2, a3]).cross(Matrix([b1, b2, b3])) = Matrix([a2*b3 - a3*b2, a3*b1 - a1*b3, a1*b2 - a2*b1])", "identity": true, "description": "a × b as a determinant with i, j, k in the first row"},
  {"unit_number": 3, "topic": "Scalar Triple Product and Applications", "name": "Scalar triple product as a determinant", "expression": "Matrix([a1, a2, a3]).dot(Matrix([b1, b2, b3]).cross(Matrix([c1, c2, c3]))) = Matrix([[a1, a2, a3], [b1, b2, b3], [c1, c2, c3]]).det()", "identity": true, "description": "a · (b × c) is the volume of the parallelepiped (in absolute value)"},

  {"unit_number": 4, "topic": "Arithmetic Progression", "name": "nth term of an A.P.", "expression": "a_n = a + (n - 1)*d", "identity": false, "description": "a = first term, d = common difference"},
  {"unit_number": 4, "topic": "Arithmetic Progression", "name": "Sum of n terms of an A.P.", "expression": "Sum(a + (k - 1)*d, (k, 1, n)) = n*(2*a + (n - 1)*d)/2", "identity": true, "description": "S_n = n/2 · [2a + (n − 1)d]"},
  {"unit_number": 4, "topic": "Geometric Progression", "name": "nth term of a G.P.", "expression": "a_n = a*r**(n - 1)", "identity": false, "description": "a = first term, r = common ratio"},
  {"unit_number": 4, "topic": "Geometric Progression", "name": "Sum of n terms of a G.P.", "expression": "Sum(a*r**(k - 1), (k, 1, n)) = a*(1 - r**n)/(1 - r)", "identity": true, "description": "S_n = a(1 − r^n)/(1 − r), r ≠ 1"},
  {"unit_number": 4, "topic": "Geometric Progression", "name": "Sum of an infinite G.P.", "expression": "S_inf = a/(1 - r)", "identity": false, "description": "Valid only when |r| < 1"},
  {"unit_number": 4, "topic": "Harmonic Progression", "name": "Harmonic mean of two numbers", "expression": "H = 2*a*b/(a + b)", "identity": false, "description": "H.M. between a and b"},
  {"unit_number": 4, "topic": "Relations between Arithmetic, Geometric and Harmonic Means", "name": "G^2 = AH", "expression": "((a + b)/2)*(2*a*b/(a + b)) = sqrt(a*b)**2", "identity": true, "description": "For positive a, b: A.M. × H.M. = (G.M.)^2"},

  {"unit_number": 5, "topic": "Sums of Powers of Natural Numbers", "name": "Sum of first n natural numbers", "expression": "Sum(k, (k, 1, n)) = n*(n + 1)/2", "identity": true, "description": "Σk = n(n + 1)/2"},
  {"unit_number": 5, "topic": "Sums of Powers of Natural Numbers", "name": "Sum of squares of first n natural numbers", "expression": "Sum(k**2, (k, 1, n)) = n*(n + 1)*(2*n + 1)/6", "identity": true, "description": "Σk^2 = n(n + 1)(2n + 1)/6"},
  {"unit_number": 5, "topic": "Sums of Powers of Natural Numbers", "name": "Sum of cubes of first n natural numbers", "expression": "Sum(k**3, (k, 1, n)) = (n*(n + 1)/2)**2", "identity": true, "description": "Σk^3 = [n(n + 1)/2]^2"},
  {"unit_number": 5, "topic": "Method of Differences", "name": "Telescoping sum of 1/(k(k+1))", "expression": "Sum(1/(k*(k + 1)), (k, 1, n)) = n/(n + 1)", "identity": true, "description": "Uses 1/(k(k+1)) = 1/k − 1/(k+1)"},

  {"unit_number": 6, "topic": "Permutations", "name": "Number of permutations", "expression": "nPr = factorial(n)/factorial(n - r)", "identity": false, "description": "Arrangements of r objects out of n distinct objects (0 ≤ r ≤ n)"},
  {"unit_number": 6, "topic": "Permutations", "name": "Circular permutations", "expression": "circular = factorial(n - 1)", "identity": false, "description": "Arrangements of n distinct objects around a circle"},
  {"unit_number": 6, "topic": "Combinations", "name": "Number of combinations", "expression": "binomial(n, r) = factorial(n)/(factorial(r)*factorial(n - r))", "identity": true, "description": "nCr, valid for integers 0 ≤ r ≤ n"},
  {"unit_number": 6, "topic": "Combinations", "name": "Pascal's rule", "expression": "binomial(n, r) + binomial(n, r - 1) = binomial(n + 1, r)", "identity": true, "description": "nCr + nC(r−1) = (n+1)Cr"},
  {"unit_number": 6, "topic": "Probability", "name": "Probability of the complementary event", "expression": "P_not_A = 1 - P_A", "identity": false, "description": "P(A') = 1 − P(A)"},
  {"unit_number": 6, "topic": "Addition and Multiplication Theorems of Probability", "name": "Addition law of probability", "expression": "P_A_or_B = P_A + P_B - P_A_and_B", "identity": false, "description": "P(A ∪ B) = P(A) + P(B) − P(A ∩ B)"},
  {"unit_number": 6, "topic": "Addition and Multiplication Theorems of Probability", "name": "Multiplication law for independent events", "expression": "P_A_and_B = P_A*P_B", "identity": false, "description": "Valid only when A and B are independent"},

  {"unit_number": 7, "topic": "Binomial Theorem for Positive Integral Index", "name": "Binomial theorem", "expression": "(a + b)**n = Sum(binomial(n, k)*a**(n - k)*b**k, (k, 0, n))", "identity": true, "description": "(a + b)^n = Σ nCk · a^(n−k) · b^k, n ∈ N"},
  {"unit_number": 7, "topic": "Binomial Theorem for Positive Integral Index", "name": "Sum of binomial coefficients", "expression": "Sum(binomial(n, k), (k, 0, n)) = 2**n", "identity": true, "description": "nC0 + nC1 + ... + nCn = 2^n"},
  {"unit_number": 7, "topic": "General Term and Middle Term", "name": "General term", "expression": "T_r_plus_1 = binomial(n, r)*a**(n - r)*b**r", "identity": false, "description": "(r + 1)th term in the expansion of (a + b)^n"},
  {"unit_number": 7, "topic": "Binomial Series for Any Index", "name": "Binomial series", "expression": "(1 + x)**m = 1 + m*x + m*(m - 1)*x**2/2 + m*(m - 1)*(m - 2)*x**3/6 + O(x**4)", "identity": false, "description": "Valid for |x| < 1 when m is negative or fractional"},

  {"unit_number": 8, "topic": "Types of Functions", "name": "Vertex of a parabola", "expression": "x_vertex = -b/(2*a)", "identity": false, "description": "For y = ax^2 + bx + c (a ≠ 0)"},
  {"unit_number": 8, "topic": "Graphs of Functions", "name": "Quadratic formula satisfies the equation", "expression": "a*((-b + sqrt(b**2 - 4*a*c))/(2*a))**2 + b*((-b + sqrt(b**2 - 4*a*c))/(2*a)) + c = 0", "identity": true, "description": "x = (−b ± √(b^2 − 4ac))/(2a) are the roots of ax^2 + bx + c = 0"},
  {"unit_number": 8, "topic": "Composite and Inverse Functions", "name": "Composite function", "expression": "fog(x) = f(g(x))", "identity": false, "description": "(f ∘ g)(x) = f(g(x))"},

  {"unit_number": 9, "topic": "Optimization by Corner Point Method", "name": "Objective function", "expression": "Z = p*x + q*y", "identity": false, "description": "Its optimum over a bounded feasible region occurs at a corner point."},
  {"unit_number": 9, "topic": "Linear Inequalities", "name": "Linear inequality in two variables", "expression": "a*x + b*y <= c", "identity": false, "description": "Its graph is a closed half-plane bounded by the line ax + by = c."},

  {"unit_number": 10, "topic": "Fundamental Law of Trigonometry", "name": "Fundamental law", "expression": "cos(x - y) = cos(x)*cos(y) + sin(x)*sin(y)", "identity": true, "description": "cos(α − β) = cos α cos β + sin α sin β"},
  {"unit_number": 10, "topic": "Sum and Difference Formulas", "name": "Cosine of a sum", "expression": "cos(x + y) = cos(x)*cos(y) - sin(x)*sin(y)", "identity": true, "description": "cos(α + β)"},
  {"unit_number": 10, "topic": "Sum and Difference Formulas", "name": "Sine of a sum", "expression": "sin(x + y) = sin(x)*cos(y) + cos(x)*sin(y)", "identity": true, "description": "sin(α + β)"},
  {"unit_number": 10, "topic": "Sum and Difference Formulas", "name": "Sine of a difference", "expression": "sin(x - y) = sin(x)*cos(y) - cos(x)*sin(y)", "identity": true, "description": "sin(α − β)"},
  {"unit_number": 10, "topic": "Sum and Difference Formulas", "name": "Tangent of a sum", "expression": "tan(x + y) = (tan(x) + tan(y))/(1 - tan(x)*tan(y))", "identity": true, "description": "tan(α + β)"},
  {"unit_number": 10, "topic": "Double and Half Angle Identities", "name": "Sine of a double angle", "expression": "sin(2*x) = 2*sin(x)*cos(x)", "identity": true, "description": "sin 2θ = 2 sin θ cos θ"},
  {"unit_number": 10, "topic": "Double and Half Angle Identities", "name": "Cosine of a double angle", "expression": "cos(2*x) = cos(x)**2 - sin(x)**2", "identity": true, "description": "cos 2θ = cos^2 θ − sin^2 θ = 2cos^2 θ − 1 = 1 − 2sin^2 θ"},
  {"unit_number": 10, "topic": "Double and Half Angle Identities", "name": "Tangent of a double angle", "expression": "tan(2*x) = 2*tan(x)/(1 - tan(x)**2)", "identity": true, "description": "tan 2θ"},
  {"unit_number": 10, "topic": "Double and Half Angle Identities", "name": "Sine squared of a half angle", "expression": "sin(x/2)**2 = (1 - cos(x))/2", "identity": true, "description": "sin^2(θ/2) = (1 − cos θ)/2"},
  {"unit_number": 10, "topic": "Product-to-Sum and Sum-to-Product Formulas", "name": "Product of sine and cosine", "expression": "2*sin(x)*cos(y) = sin(x + y) + sin(x - y)", "identity": true, "description": "2 sin α cos β = sin(α + β) + sin(α − β)"},
  {"unit_number": 10, "topic": "Product-to-Sum and Sum-to-Product Formulas", "name": "Sum of sines", "expression": "sin(x) + sin(y) = 2*sin((x + y)/2)*cos((x - y)/2)", "identity": true, "description": "sin P + sin Q = 2 sin((P+Q)/2) cos((P−Q)/2)"},
  {"unit_number": 10, "topic": "Product-to-Sum and Sum-to-Product Formulas", "name": "Difference of cosines", "expression": "cos(x) - cos(y) = -2*sin((x + y)/2)*sin((x - y)/2)", "identity": true, "description": "cos P − cos Q = −2 sin((P+Q)/2) sin((P−Q)/2)"},

  {"unit_number": 11, "topic": "Law of Sines, Cosines and Tangents", "name": "Law of sines", "expression": "a/sin(A) = b/sin(B)", "identity": false, "description": "a/sin A = b/sin B = c/sin C = 2R"},
  {"unit_number": 11, "topic": "Law of Sines, Cosines and Tangents", "name": "Law of cosines", "expression": "a**2 = b**2 + c**2 - 2*b*c*cos(A)", "identity": false, "description": "Also b^2 = c^2 + a^2 − 2ca cos B, c^2 = a^2 + b^2 − 2ab cos C"},
  {"unit_number": 11, "topic": "Law of Sines, Cosines and Tangents", "name": "Law of tangents", "expression": "(a - b)/(a + b) = tan((A - B)/2)/tan((A + B)/2)", "identity": false, "description": "Used when two sides and the included angle are known"},
  {"unit_number": 11, "topic": "Half Angle Formulas and Area of a Triangle", "name": "Semi-perimeter", "expression": "s = (a + b + c)/2", "identity": false, "description": "Semi-perimeter of a triangle"},
  {"unit_number": 11, "topic": "Half Angle Formulas and Area of a Triangle", "name": "Hero's formula", "expression": "Area = sqrt(s*(s - a)*(s - b)*(s - c))", "identity": false, "description": "Area from three sides"},
  {"unit_number": 11, "topic": "Half Angle Formulas and Area of a Triangle", "name": "Area from two sides and the included angle", "expression": "Area = b*c*sin(A)/2", "identity": false, "description": "Δ = ½ bc sin A"},
  {"unit_number": 11, "topic": "Half Angle Formulas and Area of a Triangle", "name": "Sine of a half angle in terms of sides", "expression": "sin(A/2) = sqrt((s - b)*(s - c)/(b*c))", "identity": false, "description": "sin(A/2) = √[(s − b)(s − c)/(bc)]"},
  {"unit_number": 11, "topic": "Circles Connected with a Triangle", "name": "Circum-radius", "expression": "R = a/(2*sin(A))", "identity": false, "description": "Also R = abc/(4Δ)"},
  {"unit_number": 11, "topic": "Circles Connected with a Triangle", "name": "In-radius", "expression": "r = Area/s", "identity": false, "description": "r = Δ/s"},
  {"unit_number": 11, "topic": "Circles Connected with a Triangle", "name": "Escribed radius opposite A", "expression": "r_1 = Area/(s - a)", "identity": false, "description": "r1 = Δ/(s − a)"},

  {"unit_number": 12, "topic": "Domain, Range and Period of Trigonometric Functions", "name": "Period of sine", "expression": "sin(x + 2*pi) = sin(x)", "identity": true, "description": "sin, cos, csc and sec have period 2π"},
  {"unit_number": 12, "topic": "Domain, Range and Period of Trigonometric Functions", "name": "Period of tangent", "expression": "tan(x + pi) = tan(x)", "identity": true, "description": "tan and cot have period π"},
  {"unit_number": 12, "topic": "Inverse Trigonometric Functions", "name": "Sum of inverse sine and inverse cosine", "expression": "asin(x) + acos(x) = pi/2", "identity": true, "description": "sin⁻¹x + cos⁻¹x = π/2 for −1 ≤ x ≤ 1"},
  {"unit_number": 12, "topic": "Inverse Trigonometric Functions", "name": "Sum of inverse tangents", "expression": "atan(x) + atan(y) = atan((x + y)/(1 - x*y))", "identity": false, "description": "Valid only when xy < 1"},
  {"unit_number": 12, "topic": "Solution of Trigonometric Equations", "name": "General solution of sin x = 0", "expression": "x = n*pi", "identity": false, "description": "n ∈ Z"},
  {"unit_number": 12, "topic": "Solution of Trigonometric Equations", "name": "General solution of cos x = 0", "expression": "x = (2*n + 1)*pi/2", "identity": false, "description": "n ∈ Z"},
  {"unit_number": 12, "topic": "Solution of Trigonometric Equations", "name": "General solution of tan x = k", "expression": "x = n*pi + atan(k)", "identity": false, "description": "n ∈ Z"}
]
